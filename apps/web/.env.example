# Copy to .env.local for local work. These values end up in the browser bundle,
# so they are configuration, never secrets.

# Base URL of a backend that implements packages/api/openapi.yaml.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Shown in the page title and header.
VITE_APP_NAME=Grip

# Optional ISO currency code for prices. Defaults to USD.
# VITE_CURRENCY=USD

# Optional link back to the main site, shown above the header when both are set.
# VITE_HOME_NAME=Example Films
# VITE_HOME_URL=https://example.com
